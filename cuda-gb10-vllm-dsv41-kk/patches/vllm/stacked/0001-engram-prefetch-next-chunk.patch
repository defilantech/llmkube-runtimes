-    def _read_engram_rows(self, jobs):
-        """Reader thread: host work only (no kernel launches, no CUDA waits)."""
+    def _read_engram_rows(self, jobs, prefetch=None):
+        """Reader thread: host work only (no kernel launches, no CUDA waits).
+
+        The next chunk's prefetch runs only after every gate of this step is
+        released, so nothing the device waits on depends on it.
+        """
         failure = None
+        hits = 0
         for engram, job in jobs:
             try:
-                engram.read_disk_async(job)
+                hits += bool(engram.read_disk_async(job))
             except BaseException as error:  # every gate is released regardless
                 failure = failure or error
         if failure is not None:
             raise failure
+        if any(job[4] is not None for _, job in jobs):
+            stats = self._engram_prefetch_stats
+            stats[0 if hits == len(jobs) else 1] += 1
+            if sum(stats) % 64 == 0:
+                logger.info(
+                    "Engram prefetch: %d steps used prefetched rows, %d re-read",
+                    stats[0], stats[1],
+                )
+        if prefetch is not None:
+            try:
+                self._prefetch_engram_rows(prefetch)
+            except Exception:
+                # A failed prefetch only loses the head start: the next step
+                # reads its rows as usual.
+                self._engram_pending = None
+                if not self._engram_prefetch_warned:
+                    self._engram_prefetch_warned = True
+                    logger.warning(
+                        "Engram prefetch failed; the next step reads its rows as usual",
+                        exc_info=True,
+                    )
+
+    def set_engram_prefetch(self, source):
+        """Model runner: the next chunk of the single prefilling request.
+
+        ``source`` is (host token row, start, count): the request's token IDs
+        (a host view that already holds the whole prompt), where the next chunk
+        starts and its length. The reader thread slices it after this step's
+        row IDs are ready, so the runner's write of a new prompt has landed.
+        """
+        self._engram_next = source if ENGRAM_PREFETCH else None
+
+    def _engram_prefetch_setup(self, engrams, next_chunk, row_set):
+        """Main thread, before any gate is queued: the other staging set and
+        the host hash tables. A failure here turns prefetch off for good
+        instead of failing the step."""
+        if self._engram_prefetch_off:
+            return None
+        # Set 0 wraps the cache's own planes and is built from the lookup
+        # binding, which the first staged step creates.
+        if any(engram.embed_tokens._disk_binding is None for engram in engrams):
+            return None
+        try:
+            for engram in engrams:
+                engram.embed_tokens.staged_row_set(0)
+                engram.embed_tokens.staged_row_set(row_set)
+            geometry = self._engram_host_geometry()
+        except Exception:
+            self._engram_prefetch_off = True
+            logger.warning(
+                "Engram prefetch setup failed; prefetch is off for this process",
+                exc_info=True,
+            )
+            return None
+        return {
+            "source": next_chunk,
+            "row_set": row_set,
+            "engrams": engrams,
+            "geometry": geometry,
+        }
+
+    def _engram_host_geometry(self):
+        """Main thread, once: host copies of each hash plan's tables."""
+        geometry = getattr(self, "_engram_geometry", None)
+        if geometry is None:
+            geometry = []
+            for plan in self.engram_hash.layout.hash_plans:
+                state = require_prepared(plan, "sequence.engram")
+                g = state.geometry
+                index = g.layer_ids.index(state.caps.layer_id)
+                geometry.append((
+                    state.token_map.cpu().numpy().astype(np.int64),
+                    g.multipliers[index], g.primes[index], g.offsets[index],
+                    int(state.pad_id), int(state.caps.vocab_size),
+                ))
+            self._engram_geometry = geometry
+        return geometry
+
+    def _prefetch_engram_rows(self, prefetch):
+        """Reader thread: hash the next chunk on the host and read its rows."""
+        row, start, count = prefetch["source"]
+        tokens = np.asarray(row[start : start + count], dtype=np.int64)
+        if tokens.shape[0] != count:
+            return
+        raw = np.asarray(row[max(0, start - 3) : start], dtype=np.int64)
+        keep = tokens != IMAGE_SENTINEL_BASE_ID
+        expected = {}
+        for engram in prefetch["engrams"]:
+            token_map, mult, primes, offsets, pad, vocab = prefetch["geometry"][
+                engram.layer_hash_index
+            ]
+            # The runner's lookback rule (_prepare_metadata): out-of-vocab and
+            # image IDs carry no history.
+            history = np.full(3, -1, dtype=np.int64)
+            valid = (raw >= 0) & (raw < vocab) & (raw != IMAGE_SENTINEL_BASE_ID)
+            history[3 - raw.shape[0] :] = np.where(
+                valid, token_map[np.where(valid, raw, 0)], -1
+            )
+            ids = host_engram_hashes(
+                tokens, keep, history, token_map, mult, primes, offsets, pad, vocab
+            ).reshape(-1)
+            if ENGRAM_PREFETCH_CORRUPT:
+                ids[0] ^= 1
+            engram.prefetch_rows(prefetch["row_set"], ids)
+            expected[id(engram)] = ids
+        self._engram_pending = {
+            "tokens": count, "row_set": prefetch["row_set"], "ids": expected,
+        }
 
