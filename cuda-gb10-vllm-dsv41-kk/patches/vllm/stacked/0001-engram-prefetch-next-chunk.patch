index 5ed494f901..50773b5959 100644
--- a/vllm/models/deepseek_v4_1/common/engram.py
+++ b/vllm/models/deepseek_v4_1/common/engram.py
@@ -84,6 +84,48 @@ ENGRAM_ASYNC_TRACE = os.environ.get("SPARK3_ENGRAM_ASYNC_TRACE") == "1"
 # A reader that cannot see its row IDs within this long raises instead of
 # spinning forever: the device is blocked upstream of the Engram staging.
 ENGRAM_ASYNC_TIMEOUT_S = float(os.environ.get("SPARK3_ENGRAM_ASYNC_TIMEOUT_S", "20"))
+# SPARK3_ENGRAM_PREFETCH=1 (needs SPARK3_ENGRAM_ASYNC=1): while one prefill chunk
+# runs, the reader thread hashes the next chunk of the same prompt on the host
+# and reads its rows into a second staging set. The next step uses those rows
+# only when its real row IDs equal the prefetched ones; otherwise it reads them
+# as before. Same rows, earlier.
+ENGRAM_PREFETCH = ENGRAM_ASYNC and os.environ.get("SPARK3_ENGRAM_PREFETCH") == "1"
+# Debug only: flip one prefetched ID so every step takes the mismatch path.
+ENGRAM_PREFETCH_CORRUPT = os.environ.get("SPARK3_ENGRAM_PREFETCH_CORRUPT") == "1"
+# Debug only: on every prefetch hit, also read the real rows into a scratch
+# buffer and compare them byte for byte with the prefetched set; a mismatch is
+# logged and the set is re-read, so outputs stay correct. Costs the read the
+# prefetch saves, plus host reads of write-combined memory.
+ENGRAM_PREFETCH_VERIFY = os.environ.get("SPARK3_ENGRAM_PREFETCH_VERIFY") == "1"
+
+
+def host_engram_hashes(tokens, keep, history, token_map, multipliers, primes,
+                       offsets, pad_id, vocab_size):
+    """Host copy of b12x's Engram hash for one request's contiguous chunk.
+
+    ``tokens``/``keep`` are the chunk's raw IDs and mask, ``history`` the three
+    compressed IDs before it (-1 where absent). Mirrors
+    b12x.sequence.engram.reference.hash_reference. The geometry bounds each
+    multiplier so token * multiplier stays below 2**63, so int64 is exact. A
+    result that differs from the device kernel only costs a prefetch miss: the
+    caller compares against the device IDs before using any row.
+    """
+    import numpy as np
+
+    n = tokens.shape[0]
+    valid = keep & (tokens >= 0) & (tokens < vocab_size)
+    compressed = np.where(valid, token_map[np.where(valid, tokens, 0)], -1)
+    cache = np.concatenate((history.astype(np.int64), compressed.astype(np.int64)))
+    out = np.empty((n, 24), dtype=np.int64)
+    rolling = np.zeros(n, dtype=np.int64)
+    blocked = np.zeros(n, dtype=bool)
+    for lag in range(4):
+        source = cache[3 - lag : 3 - lag + n]
+        blocked |= source == -1
+        rolling ^= np.where(blocked, pad_id, source) * int(multipliers[lag])
+        for head in range((lag - 1) * 8, lag * 8) if lag else ():
+            out[:, head] = rolling % int(primes[head]) + int(offsets[head])
+    return out
 
 
 def wait_for_event(event, what: str) -> None:
@@ -167,6 +209,50 @@ class HostGate:
         self.host.value = sequence
 
 
+class _StagedRows:
+    """One set of mapped staging planes: the reader fills it, the decode reads it.
+
+    ``done`` is recorded after the decode that last read the set, so a reader
+    never overwrites rows a queued decode still needs.
+    """
+
+    def __init__(self, weight, scale, weight_buffer, scale_buffer, done, *,
+                 used=False, ids=None, owners=()):
+        self.weight, self.scale = weight, scale
+        self.weight_buffer, self.scale_buffer = weight_buffer, scale_buffer
+        self.done, self.used = done, used
+        self.ids = ids
+        self.ids_buffer = None if ids is None else memoryview(ids)
+        self._owners = owners  # keeps the mapped allocations alive
+
+    @classmethod
+    def allocate(cls, cache, like):
+        """A second set shaped like the cache's own (about 25.5 MiB at 4K tokens)."""
+        import numpy as np
+
+        weight = MappedHostAllocation(
+            (cache.max_lookups, cache.weight_row_bytes), torch.uint8, cache.device
+        )
+        owners = [weight]
+        scale, scale_buffer = like.scale, None
+        if cache.scale_row_bytes:
+            scale_alloc = MappedHostAllocation(
+                (cache.max_lookups, cache.scale_row_bytes), torch.uint8, cache.device
+            )
+            owners.append(scale_alloc)
+            scale = scale_alloc.device_view
+            scale_buffer = memoryview(scale_alloc.host_view.numpy())
+        return cls(
+            weight.device_view.view(like.weight.dtype),
+            scale,
+            memoryview(weight.host_view.numpy()),
+            scale_buffer,
+            torch.cuda.Event(),
+            ids=np.empty((cache.max_lookups,), dtype=np.int64),
+            owners=tuple(owners),
+        )
+
+
 _ROWS_READY_FLAGS: dict[int, RowsReadyFlag] = {}
 
 
@@ -752,6 +838,12 @@ class ParallelEngramEmbedding(nn.Module):
 
     def stage_disk_async(self, indices, out, num_tokens, flag, side_stream):
         """Main thread: stage the IDs and queue the gated decode; no disk I/O."""
+        return self.stage_disk_rows(indices, out, num_tokens, flag, side_stream)
+
+    def stage_disk_rows(self, indices, out, num_tokens, flag, side_stream,
+                        row_set=0, expected_ids=None):
+        """stage_disk_async into one of the staged row sets; ``expected_ids``
+        are the IDs a prefetch already read into that set."""
         from b12x.sequence.engram._kernels import lookup_op
 
         if self.table_memory != "disk":
@@ -784,10 +876,13 @@ class ParallelEngramEmbedding(nn.Module):
             self._disk_prepared_rows = 0
         if indices.shape[0] < self._disk_prepared_rows:
             out[indices.shape[0] : self._disk_prepared_rows].zero_()
-        # The previous decode must be done with the mapped rows before the
+        # Set 0 is the cache's own staging planes; set 1 exists only with
+        # SPARK3_ENGRAM_PREFETCH and holds rows read a step early.
+        rows = self.staged_row_set(row_set)
+        # The previous decode must be done with these mapped rows before the
         # reader overwrites them; the ID copy below is ordered after it.
-        if cache._cache_used:
-            stream.wait_event(cache._cache_done)
+        if rows.used:
+            stream.wait_event(rows.done)
         count = indices.shape[0] * 24
         cache.ids_host[:count].copy_(self.hashes.view(-1)[:count], non_blocking=True)
         cache._ids_ready.record(stream)
@@ -800,46 +895,142 @@ class ParallelEngramEmbedding(nn.Module):
         with torch.cuda.stream(side_stream):
             lookup_op(
                 binding.plan.handle,
-                binding.weight,
-                binding.scale_bytes,
+                rows.weight,
+                rows.scale,
                 binding.hash_ids,
                 binding.num_tokens,
                 binding.out,
                 indices.shape[0],
                 False,
             )
-            cache._cache_done.record(side_stream)
+            rows.done.record(side_stream)
+            rows.used = True
             cache._cache_used = True
             flag.write(side_stream, 1)
         self._disk_prepared_rows = indices.shape[0]
         if ENGRAM_ASYNC_TRACE:
             logger.info(
-                "engram-async stage table=%x tokens=%d lookups=%d sequence=%d",
-                id(self), indices.shape[0], count, sequence,
+                "engram-async stage table=%x tokens=%d lookups=%d sequence=%d set=%d",
+                id(self), indices.shape[0], count, sequence, row_set,
             )
-        return indices.shape[0], count, sequence
+        return indices.shape[0], count, sequence, row_set, expected_ids
+
+    def staged_row_set(self, index):
+        """Staging planes the reader fills and the decode reads: 0 or 1."""
+        sets = getattr(self, "_row_sets", None)
+        if sets is None:
+            import numpy as np
+
+            cache = self.disk_table._cache
+            binding = self._disk_binding
+            # Prefetch reads take their IDs from the set's own buffer, not
+            # ids_host, which carries the current step's IDs.
+            sets = [_StagedRows(binding.weight, binding.scale_bytes,
+                                cache._weight_buffer, cache._scale_buffer,
+                                cache._cache_done, used=cache._cache_used,
+                                ids=np.empty((cache.max_lookups,), dtype=np.int64))]
+            self._row_sets = sets
+        if index == 1 and len(sets) == 1:
+            sets.append(_StagedRows.allocate(self.disk_table._cache, sets[0]))
+        return sets[index]
 
     def read_disk_async(self, job):
-        """Reader thread, host work only: wait for the IDs, read the rows."""
-        tokens, count, sequence = job
+        """Reader thread, host work only: wait for the IDs, read the rows.
+
+        With prefetched rows (``expected`` set) the read is skipped when the
+        real IDs equal the prefetched ones; any difference reads them as usual
+        into the same planes, so the decode always sees the real rows.
+        """
+        import numpy as np
+
+        tokens, count, sequence, row_set, expected = job
         cache = self.disk_table._cache
+        rows = self.staged_row_set(row_set)
+        hit = False
         try:
             wait_for_event(cache._ids_ready, f"row IDs for table {id(self):x} ({tokens} tokens)")
             if ENGRAM_ASYNC_DELAY:
                 time.sleep(ENGRAM_ASYNC_DELAY)
-            cache._native.ple_reader_run(
-                cache._reader,
-                cache._ids_buffer,
-                cache._weight_buffer,
-                cache._scale_buffer,
-                count,
+            hit = (
+                expected is not None
+                and expected.shape[0] == count
+                and np.array_equal(cache.ids_host.numpy()[:count], expected)
             )
+            if hit and ENGRAM_PREFETCH_VERIFY and not self._verify_prefetched(rows, count):
+                hit = False
+            if not hit:
+                cache._native.ple_reader_run(
+                    cache._reader,
+                    cache._ids_buffer,
+                    rows.weight_buffer,
+                    rows.scale_buffer,
+                    count,
+                )
         finally:
             # Release even on failure so no stream waits forever; the caller
             # re-raises the failure before the next step.
             self._read_gate.release(sequence)
         if ENGRAM_ASYNC_TRACE:
-            logger.info("engram-async rows read table=%x sequence=%d", id(self), sequence)
+            logger.info(
+                "engram-async rows read table=%x sequence=%d set=%d prefetched=%s hit=%s",
+                id(self), sequence, row_set, expected is not None, hit,
+            )
+        return hit
+
+    def _verify_prefetched(self, rows, count):
+        """SPARK3_ENGRAM_PREFETCH_VERIFY: re-read the real rows into scratch
+        and compare with the prefetched set. Returns True when equal."""
+        import numpy as np
+
+        cache = self.disk_table._cache
+        scratch = getattr(self, "_verify_scratch", None)
+        if scratch is None:
+            weight = np.empty((cache.max_lookups, cache.weight_row_bytes), np.uint8)
+            scale = (np.empty((cache.max_lookups, cache.scale_row_bytes), np.uint8)
+                     if rows.scale_buffer is not None else None)
+            scratch = self._verify_scratch = (weight, scale)
+        weight, scale = scratch
+        cache._native.ple_reader_run(
+            cache._reader,
+            cache._ids_buffer,
+            memoryview(weight),
+            None if scale is None else memoryview(scale),
+            count,
+        )
+        equal = np.array_equal(np.asarray(rows.weight_buffer)[:count], weight[:count])
+        if scale is not None:
+            equal = equal and np.array_equal(
+                np.asarray(rows.scale_buffer)[:count], scale[:count]
+            )
+        stats = getattr(self, "_verify_stats", None) or [0, 0]
+        stats[0 if equal else 1] += 1
+        self._verify_stats = stats
+        if not equal or sum(stats) % 64 == 1:
+            log = logger.warning if not equal else logger.info
+            log(
+                "Engram prefetch verify table=%x: %d hits byte-identical, %d differed",
+                id(self), stats[0], stats[1],
+            )
+        return equal
+
+    def prefetch_rows(self, row_set, ids):
+        """Reader thread: read the rows for ``ids`` (host int64) into a set.
+
+        Waits until the decode that last read this set has finished, the same
+        ordering stage_disk_async gives the current step's read.
+        """
+        rows = self.staged_row_set(row_set)
+        if rows.used:
+            wait_for_event(rows.done, f"decode of staged set {row_set} for table {id(self):x}")
+        count = ids.shape[0]
+        rows.ids[:count] = ids
+        self.disk_table._cache._native.ple_reader_run(
+            self.disk_table._cache._reader,
+            rows.ids_buffer,
+            rows.weight_buffer,
+            rows.scale_buffer,
+            count,
+        )
 
 
     def lookup_native(self, indices, out):
@@ -1101,17 +1292,22 @@ class Engram(nn.Module):
     def async_rows(self) -> bool:
         return getattr(self, "_async_rows", False)
 
-    def stage_disk_async(self, hash_ids, num_tokens, side_stream):
+    def stage_disk_async(self, hash_ids, num_tokens, side_stream, row_set=0,
+                         expected_ids=None):
         self.invalidate_disk_output()
-        job = self.embed_tokens.stage_disk_async(
-            hash_ids, self.staged_rows, num_tokens, self._rows_flag, side_stream
+        job = self.embed_tokens.stage_disk_rows(
+            hash_ids, self.staged_rows, num_tokens, self._rows_flag, side_stream,
+            row_set, expected_ids,
         )
         self._disk_prepared_tokens = hash_ids.shape[0]
         self._disk_prepared = True
         return job
 
     def read_disk_async(self, job):
-        self.embed_tokens.read_disk_async(job)
+        return self.embed_tokens.read_disk_async(job)
+
+    def prefetch_rows(self, row_set, ids):
+        self.embed_tokens.prefetch_rows(row_set, ids)
 
     def prepare_embeddings(self, hash_ids):
         self.embed_tokens.lookup(hash_ids, self.staged_rows)
